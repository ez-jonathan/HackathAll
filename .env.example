# ==============================================================================
# HackathAll Environment Configuration (Default: Zero-Friction Mock Mode)
# ==============================================================================
# ⚡ ZERO FRICTION GUARANTEE:
# When NEXT_PUBLIC_MOCK_MODE=true (or when keys are empty/unset), the entire app
# runs with instant, realistic synthetic mock fallbacks. You can build, test,
# and present without entering a single paid API key!
# ==============================================================================

# Master Switch for Offline & Fail-Safe Demo Mode
NEXT_PUBLIC_MOCK_MODE=true

# Core App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. AI & LLM Providers (Optional - Cascades to mock streams if empty)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & Auth (Supabase - Cascades to data/seed.json if empty)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Voice Synthesis (ElevenLabs - Cascades to synthetic Web Audio if empty)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 4. Communications (Twilio - Cascades to terminal SMS previews if empty)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 5. Transactional Email (Resend - Cascades to console HTML receipts if empty)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
